# Unity YAML assets are text; let git merge them line-by-line
*.unity    text eol=lf
*.prefab   text eol=lf
*.asset    text eol=lf
*.anim     text eol=lf
*.controller text eol=lf
*.meta     text eol=lf
*.cs       text eol=lf diff=csharp

# Binary assets
*.png  binary
*.wav  binary
*.wasm binary
*.data binary
*.br   binary
*.gz   binary
